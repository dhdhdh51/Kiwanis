# ---------- Core ----------
NODE_ENV=development
PORT=4000
# Public URL of the web app (used for share links, reset emails, CORS/CSRF origin checks)
APP_URL=http://localhost:5173
# Number of trusted reverse proxies in front of the API (for correct client IPs / rate limiting)
TRUST_PROXY=0
# Long random string (>= 32 chars). Signs local storage URLs and share access tokens.
APP_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vidvault?schema=public

# Bootstrap administrator (created on startup if missing)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# ---------- Storage ----------
# "local" (disk, dev/single node) or "s3" (AWS S3, MinIO, Cloudflare R2, Backblaze B2, ...)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage-data

S3_BUCKET=vidvault
S3_REGION=us-east-1
# Leave empty for AWS. For MinIO/R2 set the endpoint the API server uses to reach storage.
S3_ENDPOINT=
# Endpoint the *browser* uses for presigned URLs (defaults to S3_ENDPOINT)
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ---------- Upload limits ----------
DEFAULT_STORAGE_LIMIT_GB=100
MAX_FILE_SIZE_GB=20
# Chunk size in MB (S3 requires >= 5 MB except for the last part)
UPLOAD_CHUNK_SIZE_MB=16
# Concurrency caps advertised to the client
MAX_CONCURRENT_FILES=4
MAX_CONCURRENT_CHUNKS=4
# Abandoned upload sessions are aborted after this many hours without progress
UPLOAD_SESSION_TTL_HOURS=48
TRASH_RETENTION_DAYS=30

# ---------- Processing (optional) ----------
# Paths to ffmpeg / ffprobe. When present they extract duration, thumbnails and renditions.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Generate lower-quality MP4 renditions (480p/720p) to enable quality selection
TRANSCODE_RENDITIONS=false

# ---------- Email (optional; reset links are logged when unset) ----------
SMTP_URL=
MAIL_FROM="VidVault <no-reply@example.com>"
